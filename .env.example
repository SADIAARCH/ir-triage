# --- Decider 2B server (strands-decider serve ... --port 8000) ---
DECIDER_URL=http://localhost:8000
# Set to 1 to skip the model and use the built-in rule engine (dev / no-GPU mode)
USE_HEURISTIC=0

# --- AWS Bedrock ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Set to 1 to return a canned report instead of calling Bedrock
USE_MOCK_BEDROCK=0

# --- Policy knobs ---
ESCALATE_CONFIDENCE=0.90
ESCALATE_COOLDOWN_SEC=60
